# Ollama endpoint and local chat model
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b

# Retrieval and indexing
RAG_TOP_K=3
RAG_CHUNK_WORDS=180
RAG_CHUNK_OVERLAP=35
RAG_CANDIDATE_MULTIPLIER=4
RAG_MAX_CONTEXT_CHARS=18000

# Safety and local resource limits
MAX_UPLOAD_MB=500
RAG_STREAMING_DEFAULT=true
RAG_ANALYTICS_ENABLED=true

# Optional cross-encoder reranker (requires requirements-advanced.txt)
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional public deployment (docker-compose.production.yml)
# Point your domain's DNS A/AAAA record to the server first.
DOMAIN=your-domain.example
ACME_EMAIL=admin@example.com
APP_AUTH_USER=knowledgebase
# Generate a bcrypt hash with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'choose-a-long-password'
# Paste the generated hash below. Do not use the plaintext password here.
APP_AUTH_HASH=
APP_MEMORY_LIMIT=4g
APP_CPU_LIMIT=2.0
STREAMLIT_MAX_MESSAGE_MB=550
